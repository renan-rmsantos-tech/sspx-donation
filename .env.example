# =============================================================================
# Variáveis de ambiente — copie para .env.local (dev) ou .env (produção/Droplet)
# =============================================================================

# === Banco de dados (PostgreSQL) ===
# Local (Supabase CLI):  postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Produção (Droplet):    postgresql://<user>:<senha>@postgres:5432/donation
#                        (host `postgres` = container na rede Docker `internal`)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Opcional: override usado apenas por `npm run db:generate` / `npm run db:migrate`
# quando o DATABASE_URL do runtime não serve para DDL.
# DATABASE_URL_MIGRATE=

# === Credenciais do admin ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# === iron-session (mínimo 32 caracteres — troque em produção) ===
SESSION_PASSWORD=your-secret-key-at-least-32-characters-long-change-this

# === DigitalOcean Spaces (storage S3-compatível) ===
# Buckets: receipts (privado), pix-qr (público), product-photos (público)
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_REGION=nyc3
DO_SPACES_ACCESS_KEY_ID=
DO_SPACES_SECRET_ACCESS_KEY=
DO_SPACES_BUCKET_RECEIPTS=
DO_SPACES_BUCKET_PIX_QR=
DO_SPACES_BUCKET_PRODUCT_PHOTOS=

# URLs públicas dos buckets (expostas ao browser; também são build args do Docker)
# Ex.: https://<bucket>.nyc3.digitaloceanspaces.com
NEXT_PUBLIC_SPACES_PIX_QR_URL=
NEXT_PUBLIC_SPACES_PRODUCT_PHOTOS_URL=

# === URL pública do site (usada nos emails para logo/assets) ===
# Produção: https://ajude-o-colegio-sao-jose.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === Resend (emails de agradecimento e comunicados) ===
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# === Webhook de confirmação de doação (opcional) ===
# Recebe payloads: { donorName, donorEmail, productName, donationType, donationDate, amount? }
DONATION_NOTIFICATION_WEBHOOK_URL=
# Bearer token opcional enviado no header Authorization
DONATION_NOTIFICATION_WEBHOOK_TOKEN=
